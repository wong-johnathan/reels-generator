# ── Secrets: never committed (R-015-5; the .env file is gitignored from commit 1) ──
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
deploy/secrets/

# ── Dispatcher's parallel worktrees (never app code) ──
.worktrees/

# ── Build output, dependencies, caches ──
node_modules/
dist/
coverage/
.vitest/
*.tsbuildinfo
npm-debug.log*

# ── Runtime data created by compose volumes / bind mounts ──
backups/
data/

# ── Design-phase artifacts not published with the app ──
# The core product and design specifications are tracked in this repository.
# Supplemental gate, review, hash, mockup and tooling artifacts remain local.
/BACKLOG.md
/LEAD_PLAN.md
/RULINGS.md
/QUALIFICATION_RESULTS.md
/APPROVAL.md
/PRD_REVIEW_v1.md
/GATE_*.md
/PRD_HASHES.md
/*.sha256
/mockups/
/tools/

# ── Editor / OS noise ──
.DS_Store
*.swp
.idea/
.vscode/

# Synology metadata (the workspace lives on a NAS volume)
@eaDir/
**/@eaDir/
.DS_Store
