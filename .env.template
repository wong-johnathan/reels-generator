# reels-generator — environment template.
#
# Generated from src/config/env.ts by scripts/generate-env-template.ts.
# Do not hand-edit: `npm run verify` fails if this file is stale.
#
#   cp .env.template .env        then fill every REQUIRED line
#
# Lines marked `optional` already carry their working default, so a copied
# template boots with the defaults in place. Lines marked REQUIRED are blank
# on purpose — the startup validator names each one that is still empty when
# a container starts, and refuses to start it.

# ── app / session (web) ───────────────────────────────────────────────────────
# optional · default 8080
APP_PORT=8080
# optional · default http://localhost:8080
APP_BASE_URL=http://localhost:8080
# REQUIRED for web · at least 32 characters of random data · secret · openssl rand -hex 32
SESSION_SECRET=
# optional · default 720
SESSION_TTL_HOURS=720
# REQUIRED for web · non-empty string
OPERATOR_USERNAME=
# REQUIRED for web · at least 12 characters (hashed to argon2id at seed) · secret
OPERATOR_PASSWORD=

# ── stores ────────────────────────────────────────────────────────────────────
# REQUIRED for web, worker, ops, migrate · non-empty host name
POSTGRES_HOST=
# optional · default 5432
POSTGRES_PORT=5432
# REQUIRED for web, worker, ops, migrate · non-empty database name
POSTGRES_DB=
# REQUIRED for web, worker, ops, migrate · non-empty user name
POSTGRES_USER=
# REQUIRED for web, worker, ops, migrate · non-empty secret
POSTGRES_PASSWORD=
# REQUIRED for web, worker · redis:// or rediss:// URL
REDIS_URL=
# REQUIRED for web, worker, ops, migrate · absolute http(s) URL
MINIO_ENDPOINT=
# REQUIRED for web, worker, ops, migrate · non-empty access key
MINIO_ROOT_USER=
# REQUIRED for web, worker, ops, migrate · at least 8 characters · secret
MINIO_ROOT_PASSWORD=
# REQUIRED for web, worker, ops, migrate · non-empty bucket name
MINIO_BUCKET=
# optional · default http://localhost:8080/asset
MINIO_PUBLIC_ENDPOINT=http://localhost:8080/asset

# ── providers (worker) ────────────────────────────────────────────────────────
# REQUIRED for worker · non-empty API key · secret
DEEPSEEK_API_KEY=
# optional · default https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# optional · default deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# optional · default deepseek
RESEARCH_PROVIDER=deepseek
# optional · no default, only needed for the documented fallback
GEMINI_GROUNDING_MODEL=
# REQUIRED for worker · non-empty API key · secret
GEMINI_API_KEY=
# optional · default gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# optional · default 1K
GEMINI_IMAGE_SIZE=1K
# REQUIRED for worker · non-empty API key · secret
ELEVENLABS_API_KEY=
# REQUIRED for worker · non-empty voice id
ELEVENLABS_VOICE_ID=
# optional · default eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# optional · default 10
PROVIDER_RATE_LIMIT_PER_MIN=10
# optional · default 60
PROVIDER_TIMEOUT_IMAGE_S=60
# optional · default 60
PROVIDER_TIMEOUT_TTS_S=60
# optional · default 30
PROVIDER_TIMEOUT_SEARCH_S=30

# ── retention / render limits ─────────────────────────────────────────────────
# optional · default 365
RETENTION_DAYS=365
# optional · default 1
MAX_RENDER_CONCURRENCY=1
# optional · default 2048
RENDER_MEM_LIMIT_MB=2048
# optional · default 30
RENDER_TIMEOUT_MIN=30

# ── logging ───────────────────────────────────────────────────────────────────
# optional · default info
LOG_LEVEL=info
# optional · default UTC
TZ=UTC

# ── image source ──────────────────────────────────────────────────────────────
# Docker Hub organisation for the application images · default wongjohnathanwh741
DOCKERHUB_USER=wongjohnathanwh741

# ── ungrouped — add these to a group in scripts/generate-env-template.ts ──────
# optional · default true
MIGRATE_ON_START=true

