# reels-generator — environment template (NAMES ONLY, no values).
#
# TECH_DESIGN §9.6: this file ships names and nothing else. Copy it to the
# operator's `.env`, fill every value, and never commit that file (gitignored
# from the first commit; R-015-5). The startup validator (R-016-5) names every
# key that is still empty or malformed and refuses to start the container.
# Full instructions: docs/DEPLOYMENT.md §2.

# ── app / session (web) ──────────────────────────────────────────────────────
APP_PORT=
APP_BASE_URL=
# at least 32 random characters; generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=
OPERATOR_USERNAME=
# at least 12 characters; hashed to argon2id when the operator account is seeded
OPERATOR_PASSWORD=

# ── stores ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_URL=
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
MINIO_PUBLIC_ENDPOINT=

# ── provider credentials (worker only) ───────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# research provider: deepseek (default) or gemini (documented fallback, D7).
# GEMINI_GROUNDING_MODEL is required only when the fallback is selected.
RESEARCH_PROVIDER=
GEMINI_GROUNDING_MODEL=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_SIZE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
PROVIDER_RATE_LIMIT_PER_MIN=
PROVIDER_TIMEOUT_IMAGE_S=
PROVIDER_TIMEOUT_TTS_S=
PROVIDER_TIMEOUT_SEARCH_S=

# ── retention / render limits ────────────────────────────────────────────────
RETENTION_DAYS=
MAX_RENDER_CONCURRENCY=
RENDER_MEM_LIMIT_MB=
RENDER_TIMEOUT_MIN=

# ── logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=
TZ=

# ── release pins: DO NOT EDIT BY HAND ────────────────────────────────────────
# CI (.github/workflows/build.yml → release-manifest job) publishes `images.env`
# with the release tag and the three digest-pinned app images. Append that file
# to `.env` (docs/DEPLOYMENT.md §3) so compose pulls by digest and never builds.
# DIGEST values are the bare 64-character hex digest: compose.yaml adds the
# `sha256:` prefix it uses in the image reference.
RELEASE_TAG=
WEB_DIGEST=
WORKER_DIGEST=
OPS_DIGEST=
# Object store image, pinned by tag AND digest and supplied by the operator:
# `minio/minio` is no longer served by Docker Hub and quay.io requires registry
# auth, so this cannot be a public constant in compose.yaml. Expected shape:
#   MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-xx-xxTxx-xx-xxZ@sha256:<64 hex>
MINIO_IMAGE=
