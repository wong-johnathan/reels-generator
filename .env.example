# reels-generator — environment template (NAMES ONLY, no values).
#
# TECH_DESIGN §9.6: this file ships names and nothing else. Copy it to the
# operator's `.env`, fill every value, and never commit that file (gitignored
# from the first commit; R-015-5). The startup validator (R-016-5) names every
# key that is still empty or malformed and refuses to start the container.
# Full instructions: docs/DEPLOYMENT.md §2.

# ── app / session (web) ──────────────────────────────────────────────────────
APP_PORT=
APP_BASE_URL=
# at least 32 random characters; generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=
OPERATOR_USERNAME=
# at least 12 characters; hashed to argon2id when the operator account is seeded
OPERATOR_PASSWORD=

# ── stores ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_URL=
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
# Optional public MinIO base (e.g. https://minio.johnathanwwh.com), not the web proxy.
# Bucket comes from MINIO_BUCKET; leave empty for relative proxy links only.
MINIO_PUBLIC_ENDPOINT=

# ── provider credentials (worker only) ───────────────────────────────────────
# fake opts into the deterministic fixtures (canned script, placeholder images,
# silent audio). Leave unset to use the real vendors, which then require the
# three API keys below. Any value other than "fake" selects the real vendors.
PROVIDERS=
# DeepSeek chat key for the text stages (topic, script, storyboard).
DEEPSEEK_API_KEY=
# Optional DeepSeek endpoint override (default https://api.deepseek.com/v1).
DEEPSEEK_BASE_URL=
# Optional text model id (default deepseek-chat).
DEEPSEEK_MODEL=
# research provider: deepseek (default) or gemini (documented fallback, D7).
# GEMINI_GROUNDING_MODEL is required only when the fallback is selected.
# Apply pending migrations when web/worker boot. Default true: a pull-and-up must
# not leave the schema behind the code. Set false only if you run migrations
# deliberately as a separate step.
MIGRATE_ON_START=

RESEARCH_PROVIDER=
GEMINI_GROUNDING_MODEL=
# Gemini key for the image stage.
GEMINI_API_KEY=
# Optional image model id (default gemini-nano-banana-2.1).
GEMINI_IMAGE_MODEL=
# Image resolution: 1K (default) or 2K.
GEMINI_IMAGE_SIZE=
# ElevenLabs key for the narration (TTS) stage.
ELEVENLABS_API_KEY=
# Fallback voice id used when a series has no voice_config.voice_id set.
ELEVENLABS_VOICE_ID=
# Optional ElevenLabs model id (default eleven_multilingual_v2).
ELEVENLABS_MODEL_ID=
# Optional provider rate limit in requests per minute (default 10).
PROVIDER_RATE_LIMIT_PER_MIN=
# Optional per-provider timeouts in seconds (defaults: image 60, tts 60, search 30).
PROVIDER_TIMEOUT_IMAGE_S=
PROVIDER_TIMEOUT_TTS_S=
PROVIDER_TIMEOUT_SEARCH_S=

# ── retention / render limits ────────────────────────────────────────────────
RETENTION_DAYS=
MAX_RENDER_CONCURRENCY=
RENDER_MEM_LIMIT_MB=
RENDER_TIMEOUT_MIN=

# ── logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=
TZ=

# ── image source ─────────────────────────────────────────────────────────────
# Application images are pulled by tag (`:latest`) from Docker Hub on every
# deploy. Leave blank to use the default organisation (wongjohnathanwh741).
DOCKERHUB_USER=
